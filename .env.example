# Backend
PORT=8787
DATABASE_PATH=data/marketplace.db

# LLM match reasoning (optional).
# Without a key the app runs on template reasons — everything still works.
# The key is read server-side only and never reaches the browser.
ANTHROPIC_API_KEY=
USE_LLM_REASONS=true
LLM_TIMEOUT_MS=9000

# Frontend: only needed once the API lives on a different origin than the app.
# In dev, Vite proxies /api to PORT above and this stays unset.
# VITE_API_URL=https://your-api.example.com/api
